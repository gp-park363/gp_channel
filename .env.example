# 바로채널 환경 설정. .env.example을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다.
# 앱(uv run barochannel)과 docker compose가 함께 읽는다.

# ===== 앱 실행 =====
# Windows 브라우저의 localhost는 IPv6를 먼저 시도한다. 127.0.0.1만 열면 연결마다 0.2초가 늦어진다.
BARO_HOST=::
BARO_PORT=8000
# 개발 중에는 true. false(운영 모드)면 세션 쿠키가 HTTPS 전용이 된다.
BARO_DEBUG=true
# 로컬 시험에서 운영 모드(BARO_DEBUG=false)를 HTTP로 쓸 때만 주석을 푼다. 운영 서버에서는 풀지 않는다.
# BARO_SECURE_COOKIES=false
# 세션 서명 키. 운영에서는 긴 임의 값(python -c "import secrets;print(secrets.token_urlsafe(48))").
# BARO_DEBUG=false이면 기본값으로는 시작되지 않는다.
BARO_SECRET_KEY=dev-only-secret-key

# ===== 시스템 관리자·화면 =====
# 이 계정으로 로그인하면 바로 관리자 모드로 들어간다. 비밀번호는 8자 이상.
BARO_ADMIN_EMAIL=admin@example.com
BARO_ADMIN_PASSWORD=
# 화면 왼쪽 위 로고 옆에 보이는 회사명. 없으면 "바로채널"이다.
BARO_COMPANY_NAME=바로채널

# ===== 저장소 계정 =====
# docker-compose의 PostgreSQL·MinIO와 앱이 같은 값을 쓴다. 앱은 이 값으로 DB 접속 주소를 만든다.
# 운영에서는 영문·숫자로 된 긴 임의 값으로 바꾼다(python -c "import secrets;print(secrets.token_hex(24))").
# PostgreSQL 비밀번호는 볼륨을 처음 만들 때만 적용된다. 이미 쓰던 DB는 README의 "저장소 비밀번호"를 본다.
BARO_DB_USER=barochannel
BARO_DB_PASSWORD=barochannel
BARO_DB_NAME=barochannel
# PostgreSQL 이미지. 없으면 postgres:17(1차 NAS 설정은 postgres:17-bookworm). 데이터가 있는 DB는 바꾸지 않는다.
# BARO_POSTGRES_IMAGE=postgres:17
# 로컬 개발 서버가 붙을 DB 위치. docker-compose는 PostgreSQL을 이 포트(기본 5434)로 연다.
# 컨테이너 안의 앱은 compose가 postgres:5432로 바꿔 준다.
# BARO_DB_HOST=localhost
# BARO_DB_PORT=5434
# S3 키는 MinIO 루트 계정이기도 하다. 비밀번호는 8자 이상.
BARO_S3_ENDPOINT_URL=http://127.0.0.1:9000
BARO_S3_ACCESS_KEY=barochannel
BARO_S3_SECRET_KEY=barochannel
BARO_S3_BUCKET=barochannel

# ===== 업무 설정 (없으면 기본값) =====
# 상신 후 기안 취소가 가능한 시간. 기본 24시간.
# BARO_WITHDRAW_HOURS=24
# 첨부 허용 확장자. 쉼표로 구분하고, 없으면 기본 17종을 쓴다. 바꾸면 서버를 다시 시작한다.
# BARO_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf,txt,csv,zip,hwp,hwpx,doc,docx,xls,xlsx,ppt,pptx
# 업무 채널이 부를 수 있는 외부 시스템. "호스트" 또는 "호스트:포트"를 쉼표로 구분한다.
# 샘플 할 일 시스템(samples/todo_api.py)은 127.0.0.1:8100에서 뜬다.
BARO_INTEGRATION_ALLOWED_HOSTS=127.0.0.1:8100,localhost:8100
# 사용을 중지할 채널 유형(work, flow). 쉼표로 구분하고 바꾸면 서버를 다시 시작한다. 데이터는 남는다.
# 줄이 없으면 업무(work)를 중지한다. 모두 켜려면 빈 값으로 둔다(BARO_DISABLED_CHANNEL_TYPES=).
BARO_DISABLED_CHANNEL_TYPES=work

# ===== 로컬 HTTP 시험 (이 PC에서 컨테이너로 띄울 때) =====
# 아래 줄의 주석을 풀면 Caddy 없이 앱이 http://localhost:<BARO_APP_PORT> 로 열린다. 이 PC에서만 접속된다.
# 앱 포트는 BARO_APP_PORT(기본 8000)로 바꾼다.
# COMPOSE_FILE=docker-compose.yml:deploy/compose.local.yml

# ===== 사내망 HTTP 운영 (QNAP 1차: 도메인·HTTPS 없이 IP로 접속) =====
# 아래 두 줄의 주석을 풀면 Caddy 없이 앱이 http://<서버 IP>:<BARO_APP_PORT> 로 바로 열린다.
# 세션 쿠키가 HTTPS 전용이 아니게 되므로 외부에 열지 않는 사내망에서만 쓴다. deploy_qnap.md를 본다.
# COMPOSE_FILE=docker-compose.yml:deploy/compose.lan.yml
# BARO_APP_PORT=8000

# ===== HTTPS 운영 (2차: 도메인 결정 후, docker compose --profile app) =====
# 인터넷에 열린 클라우드 서버(iwinv)는 아래 줄을 켠다. 공식 Caddy 이미지로 Let's Encrypt HTTP 확인을 하므로
# CLOUDFLARE_API_TOKEN이 필요 없다(deploy_iwinv.md). deploy/server.sh env가 알아서 넣는다.
# COMPOSE_FILE=docker-compose.yml:deploy/compose.public.yml
# 도메인 없이 서버 IP로 접속하려면 BARO_DOMAIN에 서버 공인 IP를 넣고 아래 줄을 켠다(https://<IP>).
# BARO_CADDYFILE=Caddyfile.ip
# 접속 주소. Cloudflare DNS 인증으로 Let's Encrypt 인증서를 받으므로 서버를 외부에 열 필요가 없다.
# DNS가 이 서버의 IP를 가리켜야 한다(Cloudflare A 레코드 DNS only, 또는 PC의 hosts 파일).
BARO_DOMAIN=gw.goodpackage.co.kr
# Cloudflare API 토큰. 권한: Zone → DNS → Edit, 영역: 해당 도메인. 없거나 틀리면 Caddy가 시작하지 않는다.
CLOUDFLARE_API_TOKEN=
# 80·443을 다른 서비스가 쓰면 바꾼다(QNAP NAS: 8880, 8888). 접속 주소에 :포트가 붙는다.
# # 도메인 없이 VPN IP·localhost로만 접속하면(Cloudflare 토큰 없이) 아래 줄을 켠다. deploy/Caddyfile.local
# BARO_CADDYFILE=Caddyfile.local
BARO_HTTP_PORT=80
# BARO_HTTPS_PORT=443

# ===== VPN 외부 접속 (Tailscale, 도메인 없이 IP로) =====
# 이 PC의 Tailscale IP(tailscale ip -4). 넣으면 https://<IP>:<HTTPS 포트> 로 접속할 수 있다.
# 자체 CA 인증서라 접속 기기마다 caddy-root.crt를 등록한다. README의 "VPN 외부 접속"을 본다.
# BARO_VPN_IP=100.64.0.1
