# 도메인 없이 서버 공인 IP로 접속할 때(https://<IP>). deploy/compose.public.yml이
# .env의 BARO_CADDYFILE=Caddyfile.ip일 때 이 파일을 쓴다. BARO_DOMAIN에는 서버 공인 IP를 넣는다.
#
# Let's Encrypt는 IP 주소 인증서를 단기(shortlived, 약 6일) 프로필로만 발급한다. Caddy가 80·443으로
# 확인받아 발급하고 만료 전에 알아서 갱신하므로, 80·443은 늘 열려 있어야 한다(Caddy 2.11 이상).
# 나중에 도메인을 연결하면 BARO_DOMAIN을 도메인으로 바꾸고 BARO_CADDYFILE 줄을 지운다(deploy_iwinv.md).
{
	# 브라우저는 IP로 접속할 때 서버 이름(SNI)을 보내지 않는다. 그때 이 IP의 인증서를 쓴다.
	default_sni {$BARO_DOMAIN}
}

{$BARO_DOMAIN} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	# 업로드 한도(BARO_MAX_UPLOAD_MB × 파일 수)보다 넉넉하게 둔다.
	request_body {
		max_size 300MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Caddy가 X-Forwarded-Proto를 넘기므로 앱은 https 주소로 리다이렉트와 링크를 만든다.
	reverse_proxy app:8000
}
